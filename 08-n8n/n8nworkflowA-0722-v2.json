    {
      "parameters": {
        "jsCode": "// --- 智能上下文处理器 (v4 - 修复了多文件字符串) ---\n\n// 1. 获取所有必需的上游节点数据\nconst triggerBody = $('Mattermost New Issue Trigger').item.json.body;\nconst postDetails = $('Get Post Details').item.json;\n\nlet sessionId;\nlet rootId;\nlet originalContext;\n\n// 2. 从触发器获取用户的当前指令\nconst userMessage = triggerBody.text.replace('!ai', '').trim();\nconst channelId = postDetails.channel_id;\n\n// 3. 核心逻辑：判断是新会话还是回复\nif (postDetails.root_id === \"\") {\n    sessionId = postDetails.id;\n    rootId = postDetails.id;\n    originalContext = \"这是一个全新的、由用户发起的AIOps诊断请求。\";\n} else {\n    sessionId = postDetails.root_id;\n    rootId = postDetails.root_id;\n    originalContext = \"\"; \n}\n\n// 4. (可选) 处理文件上传\nlet fileIdsInput = triggerBody.file_ids || [];\nlet finalFileIds = [];\n\nif (Array.isArray(fileIdsInput)) {\n    finalFileIds = fileIdsInput;\n} else if (typeof fileIdsInput === 'string' && fileIdsInput.length > 0) {\n    if (fileIdsInput.includes(',')) {\n        finalFileIds = fileIdsInput.split(',');\n    } else {\n        finalFileIds = [fileIdsInput];\n    }\n}\n\n// 5. 将计算好的变量打包输出\nreturn [{\n  json: {\n    incidentSessionId: sessionId,\n    currentUserMessage: userMessage,\n    channelId: channelId,\n    rootId: rootId,\n    originalContext: originalContext,\n    fileIds: finalFileIds\n  }\n}];"
      },
